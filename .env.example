APP_NAME="Go React Boilerplate"
APP_URL="http://localhost:5173"
APP_LOCALE="id"
APP_ENV="development"
LISTEN="127.0.0.1:8080"
LOG_LEVEL="info"

# Database (Compose publishes Postgres on 54330 to avoid clashing with a
# system Postgres on 5432).
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54330/go_react_boilerplate?sslmode=disable"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-secret"
SESSION_TTL_HOURS="168"

# Browser origins allowed to send mutations. Vite dev + the production URL.
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Mail (Mailpit in development, any SMTP provider in production).
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="hello@example.com"

RATE_LIMIT_PER_MINUTE="20"
COOKIE_SECURE=""
